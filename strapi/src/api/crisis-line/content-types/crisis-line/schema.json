{
  "kind": "collectionType",
  "collectionName": "crisis_lines",
  "info": {
    "singularName": "crisis-line",
    "pluralName": "crisis-lines",
    "displayName": "Krizová linka",
    "description": "Krizové a tísňové linky"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "lineId": {
      "type": "uid",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "phones": {
      "type": "component",
      "repeatable": true,
      "component": "shared.phone-number"
    },
    "description": {
      "type": "richtext"
    },
    "availability": {
      "type": "string"
    },
    "free": {
      "type": "boolean",
      "default": false
    },
    "email": {
      "type": "email"
    },
    "website": {
      "type": "string"
    },
    "targetGroup": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "lifeSituations": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::life-situation.life-situation",
      "mappedBy": "crisisLines"
    }
  }
}
