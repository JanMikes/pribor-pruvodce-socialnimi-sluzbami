{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Služba",
    "description": "Služba poskytovatele"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "serviceId": {
      "type": "uid",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "contacts": {
      "type": "component",
      "repeatable": true,
      "component": "shared.contact-info"
    },
    "provider": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::provider.provider",
      "inversedBy": "services"
    },
    "lifeSituations": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::life-situation.life-situation",
      "mappedBy": "services"
    }
  }
}
